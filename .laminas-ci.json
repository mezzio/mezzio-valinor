{
    "backwardCompatibilityCheck": true,
    "exclude": [
        {
            "name": "Infection"
        }
    ],
    "extensions": [
        "bcmath",
        "pcov"
    ],
    "additional_checks": [
        {
            "name": "Infection (PCOV)",
            "job": {
                "php": "@lowest",
                "dependencies": "locked",
                "command": ".\/vendor\/bin\/roave-infection-static-analysis-plugin"
            }
        }
    ],
    "ignore_php_platform_requirements": {
        "8.6": true
    }
}